        $ref: '#/definitions/models.AIEffectiveness'
  models.AIFeature:
    title: AIFeature
    description: |-
      AIFeature represents an AI feature available in the product. Flag is the LaunchDarkly
      key that gates it: if the flag is not defined in LaunchDarkly the feature is shown,
      otherwise its LaunchDarkly targeting decides visibility per installation.
    type: object
    properties:
      id:
        description: 'nolint: staticcheck'
        type: integer
      name:
        type: string
