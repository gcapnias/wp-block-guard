  models.AIEffectiveness:
    title: AIEffectiveness
    description: |-
      AIEffectiveness reports how closely the replies an agent sent matched the AI
      draft over the current billing period. Every field except Sent is a
      percentage; the three bands sum to 100 once Sent is non-zero.
    type: object
    properties:
      avgSimilarity:
        type: number
      edited:
        type: number
      resetDate:
        type: string
        format: date-time
      rewritten:
        type: number
      sent:
        type: integer
      sentAsIs:
        type: number
