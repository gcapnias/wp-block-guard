{
  "$schema": "https://www.designtokens.org/tr/drafts/format/",
  "color": {
    "dark-bg": {
      "$type": "color",
      "$value": "#1a0818"
    },
    "error": {
      "$type": "color",
      "$value": "#cf2e2e"
    },
    "neutral": {
      "$type": "color",
      "$value": "#918891"
    },
    "on-error": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "on-primary": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "on-secondary": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "on-surface": {
      "$type": "color",
      "$value": "#1a0818"
    },
    "on-surface-variant": {
      "$type": "color",
      "$value": "#374151"
    },
    "on-tertiary": {
      "$type": "color",
      "$value": "#1a0818"
    },
    "outline": {
      "$type": "color",
      "$value": "rgba(147, 26, 129, 0.12)"
    },
    "primary": {
      "$type": "color",
      "$value": "#931a81"
    },
    "primary-dark": {
      "$type": "color",
      "$value": "#6b1260"
    },
    "secondary": {
      "$type": "color",
      "$value": "#9335b6"
    },
    "surface": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "tertiary": {
      "$type": "color",
      "$value": "#fdb927"
    }
  },
  "component": {
    "badge": {
      "background-color": {
        "$type": "color",
        "$value": "rgba(147, 26, 129, 0.12)"
      },
      "border-radius": {
        "$type": "dimension",
        "$value": "8px"
      },
      "padding": {
        "$type": "dimension",
        "$value": "4.8px 12px"
      },
      "text-color": {
        "$type": "color",
        "$value": "#931a81"
      }
    },
    "button-primary": {
      "background-color": {
        "$type": "color",
        "$value": "#9335b6"
      },
      "border-radius": {
        "$type": "dimension",
        "$value": "4px"
      },
      "padding": {
        "$type": "dimension",
        "$value": "8px 16px"
      },
      "text-color": {
        "$type": "color",
        "$value": "#ffffff"
      }
    },
    "button-primary-hover": {
      "background-color": {
        "$type": "color",
        "$value": "#6b1260"
      },
      "text-color": {
        "$type": "color",
        "$value": "#ffffff"
      }
    },
    "card": {
      "background-color": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "border-radius": {
        "$type": "dimension",
        "$value": "16px"
      },
      "padding": {
        "$type": "dimension",
        "$value": "1.5rem"
      },
      "text-color": {
        "$type": "color",
        "$value": "#1a0818"
      }
    },
    "input-field": {
      "background-color": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "border-radius": {
        "$type": "dimension",
        "$value": "0px"
      },
      "padding": {
        "$type": "dimension",
        "$value": "0.5rem 0.75rem"
      },
      "text-color": {
        "$type": "color",
        "$value": "#374151"
      }
    },
    "nav-link": {
      "padding": {
        "$type": "dimension",
        "$value": "6.4px 13.6px"
      },
      "text-color": {
        "$type": "color",
        "$value": "#1a0818"
      }
    },
    "nav-link-hover": {
      "text-color": {
        "$type": "color",
        "$value": "#931a81"
      }
    }
  },
  "rounded": {
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "md": {
      "$type": "dimension",
      "$value": "8px"
    },
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "4px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "24px"
    }
  },
  "shadow": {
    "lg": {
      "$type": "shadow",
      "$value": [
        {
          "blur": {
            "unit": "px",
            "value": 40
          },
          "color": "rgba(147, 26, 129, 0.22)",
          "offsetX": {
            "unit": "px",
            "value": 0
          },
          "offsetY": {
            "unit": "px",
            "value": 12
          }
        },
        {
          "blur": {
            "unit": "px",
            "value": 8
          },
          "color": "rgba(0, 0, 0, 0.10)",
          "offsetX": {
            "unit": "px",
            "value": 0
          },
          "offsetY": {
            "unit": "px",
            "value": 2
          }
        }
      ]
    },
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "blur": {
            "unit": "px",
            "value": 20
          },
          "color": "rgba(147, 26, 129, 0.10)",
          "offsetX": {
            "unit": "px",
            "value": 0
          },
          "offsetY": {
            "unit": "px",
            "value": 4
          }
        },
        {
          "blur": {
            "unit": "px",
            "value": 4
          },
          "color": "rgba(0, 0, 0, 0.06)",
          "offsetX": {
            "unit": "px",
            "value": 0
          },
          "offsetY": {
            "unit": "px",
            "value": 1
          }
        }
      ]
    },
    "sm": {
      "$type": "shadow",
      "$value": {
        "blur": {
          "unit": "px",
          "value": 4
        },
        "color": "rgba(0, 0, 0, 0.06)",
        "offsetX": {
          "unit": "px",
          "value": 0
        },
        "offsetY": {
          "unit": "px",
          "value": 1
        }
      }
    },
    "xl": {
      "$type": "shadow",
      "$value": {
        "blur": {
          "unit": "px",
          "value": 50
        },
        "color": "rgba(0, 0, 0, 0.4)",
        "offsetX": {
          "unit": "px",
          "value": 12
        },
        "offsetY": {
          "unit": "px",
          "value": 12
        }
      }
    }
  },
  "spacing": {
    "gutter": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "lg": {
      "$type": "dimension",
      "$value": "2.5rem"
    },
    "margin": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "md": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "sm": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "xl": {
      "$type": "dimension",
      "$value": "4rem"
    },
    "xs": {
      "$type": "dimension",
      "$value": "0.5rem"
    }
  },
  "typography": {
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFallback": "Nunito",
        "fontFamily": "Figtree",
        "fontSize": "17px",
        "fontWeight": 400,
        "lineHeight": "28px"
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFallback": "Nunito",
        "fontFamily": "Figtree",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": "22.4px"
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFallback": "Nunito",
        "fontFamily": "Figtree",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": "18px"
      }
    },
    "headline-display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Source Sans 3",
        "fontSize": "57.6px",
        "fontWeight": 900,
        "letterSpacing": "-0.03em",
        "lineHeight": "60.48px"
      }
    },
    "headline-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Source Sans 3",
        "fontSize": "35.2px",
        "fontWeight": 700,
        "letterSpacing": "-0.01em",
        "lineHeight": "42px"
      }
    },
    "headline-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Source Sans 3",
        "fontSize": "28px",
        "fontWeight": 700,
        "lineHeight": "34px"
      }
    },
    "headline-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Source Sans 3",
        "fontSize": "22px",
        "fontWeight": 600,
        "lineHeight": "28px"
      }
    },
    "label-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Source Sans 3",
        "fontSize": "15.2px",
        "fontWeight": 700,
        "letterSpacing": "0.02em",
        "lineHeight": "25px"
      }
    },
    "label-md": {
      "$type": "typography",
      "$value": {
        "fontFallback": "Nunito",
        "fontFamily": "Figtree",
        "fontSize": "14px",
        "fontWeight": 500,
        "lineHeight": "21px"
      }
    },
    "label-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Source Serif 4",
        "fontSize": "11.52px",
        "fontWeight": 700,
        "letterSpacing": "0.08em",
        "lineHeight": "19px"
      }
    }
  }
}
