{
  "name": "wp-block-guard",
  "version": "0.1.0",
  "description": "Pre-publish validator for WordPress Gutenberg block markup (.html files, .php fragments) designed for AI coding agents. Wraps block-runner's headless-Gutenberg save()-diff check with a PHP-fragment flagging layer and a zero-dependency structural delimiter pre-check.",
  "type": "module",
  "bin": {
    "wp-block-guard": "./bin/wp-block-guard.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "license": "MIT",
  "keywords": [
    "wordpress",
    "gutenberg",
    "block-markup",
    "validator",
    "cli",
    "ai-agent"
  ],
  "scripts": {
    "start": "node bin/wp-block-guard.js",
    "test": "vitest run",
    "compile": "bun build --compile ./bin/wp-block-guard.js --outfile bin/wp-block-guard.exe",
    "measure:boot": "bash scripts/measure-boot.sh",
    "analyse:boot": "node scripts/analyse-boot-timings.mjs"
  },
  "dependencies": {
    "block-runner": "^0.9.7",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
